{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taigamcp.local/schemas/review-receipt-v1.schema.json",
  "title": "Taiga ticket loop review receipt v1",
  "type": "object",
  "$defs": {
    "verdict": { "type": "string", "enum": ["pass", "changes_requested", "blocked"] },
    "severity": { "type": "string", "enum": ["blocker", "critical", "high", "medium", "low", "info"] },
    "disposition": { "type": "string", "enum": ["open", "fixed", "rejected_accepted", "escalated"] },
    "reviewDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSha", "toSha", "changedPaths", "documentationChanged", "documentationPaths", "documentationAssessment", "reusedCheckIds", "reuseJustification"],
      "properties": {
        "fromSha": { "type": "string", "minLength": 1 },
        "toSha": { "type": "string", "minLength": 1 },
        "changedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "documentationChanged": { "type": "boolean" },
        "documentationPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "documentationAssessment": { "type": "string", "minLength": 1 },
        "reusedCheckIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reuseJustification": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "runId", "actionId", "ticketKey", "scopeHash", "baseSha", "reviewedSha", "verdict", "reviewerModel", "reviewerEffort", "criteria", "checks", "findings"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "review" },
        "runId": { "type": "string", "minLength": 1 },
        "actionId": { "type": "string", "minLength": 1 },
        "ticketKey": { "type": "string", "minLength": 1 },
        "scopeHash": { "type": "string", "minLength": 1 },
        "baseSha": { "type": "string", "minLength": 1 },
        "reviewedSha": { "type": "string", "minLength": 1 },
        "verdict": { "$ref": "#/$defs/verdict" },
        "reviewerModel": { "type": "string", "const": "gpt-6.1-sol" },
        "reviewerEffort": { "type": "string", "const": "high" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "passed", "evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exitCode", "evidence"],
            "properties": {
              "checkId": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "exitCode": { "type": "integer", "minimum": 0 },
              "evidence": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" },
              "evidenceId": { "type": "string", "minLength": 1 },
              "criterionIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "taskAcceptances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "accepted", "reviewedSha", "criterionIds", "evidence"],
            "properties": {
              "taskId": { "type": "integer", "minimum": 1 },
              "accepted": { "type": "boolean" },
              "reviewedSha": { "type": "string", "minLength": 1 },
              "reviewerId": { "type": "string", "minLength": 1 },
              "criterionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "evidence", "requestedChange", "disposition"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "severity": { "$ref": "#/$defs/severity" },
              "evidence": { "type": "string", "minLength": 1 },
              "requestedChange": { "type": "string", "minLength": 1 },
              "disposition": { "$ref": "#/$defs/disposition" }
            }
          }
        },
        "reviewDelta": { "$ref": "#/$defs/reviewDelta" }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/review" }]
}
