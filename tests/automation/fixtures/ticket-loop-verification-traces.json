{
  "schemaVersion": 1,
  "scenarios": [
    {
      "name": "implementation-review-correction",
      "actors": ["implementer", "reviewer"],
      "operations": ["plan", "execute_checks", "review", "route_finding", "correct", "rereview"],
      "expected": { "coordinatorEngineeringActions": 0, "sameWorkerIds": true, "technicalFindingBlocks": true }
    },
    {
      "name": "seeded-ui-is-not-a-click",
      "evidence": { "reportedAction": "seeded_state", "actualAction": "none" },
      "expected": { "freshUiEvidence": false, "requiresActualInteraction": true }
    },
    {
      "name": "intentional-host-stop",
      "evidence": { "actualExitCode": 1, "outcome": "intentional_stop_failed" },
      "expected": { "countsAsCheckPass": false, "rawExitPreserved": true }
    },
    {
      "name": "shared-output-sequencing",
      "checks": ["build-a", "build-b", "independent-read"],
      "expected": { "buildsSerialized": true, "independentReadMayBatch": true }
    }
  ]
}
