{
  "schemaVersion": 1,
  "scenarios": [
    {
      "name": "two-independent-tickets",
      "tickets": ["project:1:issue:11", "project:1:issue:12"],
      "operations": ["reserve-slot:issue:11", "reserve-slot:issue:12", "wait:issue:11", "wait:issue:12"],
      "expected": { "siblingsContinue": true, "maxRepositorySlots": 2 }
    },
    {
      "name": "dependent-ticket",
      "tickets": ["project:1:story:20", "project:1:task:21"],
      "operations": ["wait-dependency:task:21", "accept-story:20", "dispatch-task:21"],
      "expected": { "dependencyBlocksChild": true, "childDispatchAfterParent": true }
    },
    {
      "name": "epic-observer",
      "tickets": ["project:1:epic:30", "project:1:story:31"],
      "operations": ["observe-epic:30", "verify-integrated-story:31", "finalize-epic:30"],
      "expected": { "combinedAcceptanceRequired": true }
    },
    {
      "name": "pause-and-publication-recovery",
      "tickets": ["project:1:issue:40"],
      "operations": ["prepare-publication:issue:40", "pause-intent:issue:40", "reconcile-quiescent:issue:40", "observe-publication-uncertain:issue:40"],
      "expected": { "newDispatchAfterPause": false, "uncertainPublicationDoesNotRestartImplementation": true, "operationCountIsDescriptive": true }
    }
  ]
}
